APP_ENV=development
APP_NAME=Spike Technology API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Local Python process values. Docker Compose overrides these host names for containers.
DATABASE_URL=postgresql+asyncpg://spike:spike_local_password@localhost:5432/spike
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-unique-48-character-or-longer-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Keep console only for local development. Production must use ses.
EMAIL_BACKEND=console
AWS_REGION=
SES_FROM_EMAIL=
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Rate limit policy for authentication endpoints.
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
