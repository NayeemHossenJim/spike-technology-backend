APP_ENV=development
APP_NAME=Spike Technology API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Local Python process values. Docker Compose overrides these host names for containers.
DATABASE_URL=postgresql+asyncpg://spike:spike_local_password@localhost:5432/spike
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-unique-48-character-or-longer-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Keep console only for local development. Production must use ses.
EMAIL_BACKEND=console
AWS_REGION=
SES_FROM_EMAIL=
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Increment this identifier whenever the Terms/Privacy text changes.
TERMS_VERSION=v1

# Rate limit policy for authentication endpoints.
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Direct report uploads remain disabled until a dedicated private S3 bucket is configured.
# Credentials are intentionally omitted: use an AWS profile locally and an IAM role in deployment.
S3_UPLOADS_ENABLED=false
S3_UPLOAD_BUCKET=
S3_UPLOAD_PREFIX=report-uploads
S3_PRESIGNED_POST_EXPIRE_MINUTES=10

# Stripe is optional in local development. Enable it only after creating sandbox
# monthly Prices for Premium ($59.99) and Pro Plan ($99.99).
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_CHECKOUT_SESSION_MINUTES=60
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Gemini remains disabled locally until a developer API key is configured.
# Never commit or paste a real GEMINI_API_KEY.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
