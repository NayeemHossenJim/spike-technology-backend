# Spike Technology production configuration template.
#
# TEMPLATE ONLY. Never commit real production credentials.
# Prefer a deployment secret manager / platform secret store.

APP_ENV=production
APP_NAME=Spike Technology API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<postgres-host>:5432/<database>
REDIS_URL=rediss://<redis-host>:6379/0
CELERY_BROKER_URL=rediss://<redis-host>:6379/0
CELERY_RESULT_BACKEND=rediss://<redis-host>:6379/1
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Required in production. Generate a unique high-entropy value and keep it in the secret manager.
METRICS_BEARER_TOKEN=<generate-a-unique-high-entropy-metrics-token>

JWT_SECRET_KEY=<generate-a-unique-high-entropy-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com

EMAIL_BACKEND=ses
AWS_REGION=<aws-region>
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=30
AWS_MAX_ATTEMPTS=3
SES_FROM_EMAIL=<verified-sender@example.com>
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
TERMS_VERSION=v1

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

S3_UPLOADS_ENABLED=true
S3_UPLOAD_BUCKET=<private-production-bucket>
S3_UPLOAD_PREFIX=report-uploads
S3_PRESIGNED_POST_EXPIRE_MINUTES=10

STRIPE_ENABLED=true
STRIPE_SECRET_KEY=<stripe-live-secret-from-secret-manager>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret-from-secret-manager>
STRIPE_PREMIUM_MONTHLY_PRICE_ID=<premium-live-price-id>
STRIPE_PRO_MONTHLY_PRICE_ID=<pro-live-price-id>
STRIPE_CHECKOUT_SUCCESS_URL=https://app.example.com/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://app.example.com/billing/cancel
STRIPE_CHECKOUT_SESSION_MINUTES=60
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

GEMINI_ENABLED=true
GEMINI_API_KEY=<gemini-api-key-from-secret-manager>
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096

AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
