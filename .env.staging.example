# Spike Technology staging configuration template.
# TEMPLATE ONLY. Never commit real staging credentials.
#
# Staging uses production-like security and infrastructure controls.
# Stripe remains in TEST mode so staging can never create live charges.

APP_ENV=staging
APP_NAME=Spike Technology API
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<staging-postgres-host>:5432/<database>

REDIS_URL=rediss://<staging-redis-host>:6379/0
CELERY_BROKER_URL=rediss://<staging-redis-host>:6379/0
CELERY_RESULT_BACKEND=rediss://<staging-redis-host>:6379/1

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10

REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Generate unique staging-only secrets and store them in the
# deployment platform secret manager.
METRICS_BEARER_TOKEN=<generate-staging-metrics-token>
JWT_SECRET_KEY=<generate-staging-jwt-secret>

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

FRONTEND_URL=https://staging-app.example.com
CORS_ORIGINS=https://staging-app.example.com
TRUSTED_HOSTS=staging-api.example.com

EMAIL_BACKEND=ses

AWS_REGION=<aws-region>
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=30
AWS_MAX_ATTEMPTS=3

SES_FROM_EMAIL=<verified-staging-sender@example.com>

EMAIL_VERIFICATION_EXPIRE_MINUTES=10
PASSWORD_RESET_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

TERMS_VERSION=v1

AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

S3_UPLOADS_ENABLED=true
S3_UPLOAD_BUCKET=<private-staging-bucket>
S3_UPLOAD_PREFIX=report-uploads
S3_PRESIGNED_POST_EXPIRE_MINUTES=10

# STAGING MUST USE STRIPE TEST MODE.
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=<sk_test_staging_secret>
STRIPE_WEBHOOK_SECRET=<whsec_staging_webhook_secret>
STRIPE_PREMIUM_MONTHLY_PRICE_ID=<staging-premium-price-id>
STRIPE_PRO_MONTHLY_PRICE_ID=<staging-pro-price-id>

STRIPE_CHECKOUT_SUCCESS_URL=https://staging-app.example.com/billing/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://staging-app.example.com/billing/cancel

STRIPE_CHECKOUT_SESSION_MINUTES=60
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

GEMINI_ENABLED=true
GEMINI_API_KEY=<staging-gemini-api-key>
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=4096

AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
